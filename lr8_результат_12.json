  "код_студента": {
    "tournament": "def tournament(F, k, rng):\n    \"\"\"Повертає індекс найкоротшої з k випадкових особин (із поверненням).\"\"\"\n    candidates = rng.integers(0, len(F), size=k)\n    values = np.asarray(F)[candidates]\n    return int(candidates[np.argmin(values)])\n",
    "ox": "def ox(p1, p2, i, j):\n    \"\"\"Зберігає відрізок p1[i:j+1], додає гени p2 по колу після j.\"\"\"\n    a, b = np.asarray(p1), np.asarray(p2)\n    child = np.empty_like(a)\n    child[i:j + 1] = a[i:j + 1]\n    retained = set(a[i:j + 1])\n    donor_order = np.concatenate((b[j + 1:], b[:j + 1]))\n    genes = [gene for gene in donor_order if gene not in retained]\n    tail = len(a) - j - 1\n    child[j + 1:] = genes[:tail]\n    child[:i] = genes[tail:]\n    return child\n",
    "choose_next": "def choose_next(cur, left, tau, eta, alpha, beta, rng):\n    \"\"\"Вибирає невідвідану точку з вагою tau**alpha * eta**beta.\"\"\"\n    candidates = np.asarray(left, dtype=np.intp)\n    if candidates.size == 1:\n        return int(candidates[0])\n    weights = np.power(tau[cur, candidates], alpha) * np.power(eta[cur, candidates], beta)\n    total = weights.sum()\n    probabilities = weights / total if np.isfinite(total) and total > 0 else None\n    return int(rng.choice(candidates, p=probabilities))\n",
    "update_pheromone": "def update_pheromone(tau, tours, lens, rho):\n    \"\"\"Випаровує феромон і додає 1/L до кожної спрямованої дуги маршруту.\"\"\"\n    updated = np.asarray(tau, dtype=float) * (1 - rho)\n    for genome, length in zip(tours, lens, strict=True):\n        route = np.concatenate(([0], genome, [0])).astype(np.intp)\n        np.add.at(updated, (route[:-1], route[1:]), 1 / length)\n    return updated\n"
  },
